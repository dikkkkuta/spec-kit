# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_me_with_strong_secret

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academic_ease?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/academic_ease?schema=public
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academic_ease_shadow?schema=public

# --- Cache & Queue ---
REDIS_URL=redis://default:password@localhost:6379
BULLMQ_PREFIX=academic-ease

# --- Storage (S3-compatible) ---
S3_BUCKET=academic-ease-assets
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.amazonaws.com
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me

# --- AI Providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_FEATURES_ENABLED=true

# --- Email / Notifications ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=\"Academic Ease <noreply@husseinkarmali.ca>\"
RESEND_API_KEY=

# --- Security & Monitoring ---
SENTRY_DSN=
DATADOG_API_KEY=

# --- Third-party Integrations ---
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# --- Misc ---
FEATURE_FLAG_PROVIDER_KEY=
